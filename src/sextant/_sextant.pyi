class Axes:
    def line(self, x: ArrayLike, y: ArrayLike | None = None, *, err: ErrorBar | None = None, **opts: Unpack[LineOptions]) -> Axes:
        """
        line(x, y=None, *, err=None, **opts)

        A line through (x, y); line(y) plots y against 0, 1, 2, ...

        Keyword options (LineOptions): color, linewidth, linestyle, name, show_legend, alpha, loop, errorbar, hint_labels.
        """

    def scatter(self, x: ArrayLike, y: ArrayLike, *, err: ErrorBar | None = None, **opts: Unpack[ScatterOptions]) -> Axes:
        """
        scatter(x, y, *, err=None, **opts)

        Markers at (x, y).

        Keyword options (ScatterOptions): color, size, marker, name, show_legend, alpha, edgecolor, edge_alpha, edge_linewidth, errorbar, hint_labels.
        """

    def scatter_z(self, x: ArrayLike, y: ArrayLike, z: ArrayLike, *, err: ErrorBar | None = None, **opts: Unpack[ScatterZOptions]) -> Axes:
        """
        scatter_z(x, y, z, *, err=None, **opts)

        Markers at (x, y), coloured by z through cmap/vmin/vmax.

        Keyword options (ScatterZOptions): cmap, size, marker, alpha, edgecolor, edge_alpha, edge_linewidth, vmin, vmax, colorbar, name, show_legend, errorbar, hint_labels.
        """

    def bar(self, x: ArrayLike, height: ArrayLike, *, err: ErrorBar | None = None, **opts: Unpack[BarOptions]) -> Axes:
        """
        bar(x, height, *, err=None, **opts)

        Bars centred on x.

        Keyword options (BarOptions): color, width, alpha, name, show_legend, edgecolor, linewidth, errorbar, hint_labels.
        """

    def heatmap(self, data: ArrayLike, xrange: tuple[float, float], yrange: tuple[float, float], **opts: Unpack[HeatmapOptions]) -> Axes:
        """
        heatmap(data, xrange, yrange, **opts)

        A 2-D array (rows, cols) drawn over xrange x yrange, (lo, hi) tuples of outer cell edges.

        Keyword options (HeatmapOptions): cmap, vmin, vmax, colorbar, name, origin, contours, contour_color, contour_linewidth, contour_labels, contour_fontsize, hint_labels.
        """

    def imshow(self, data: ArrayLike, **opts: Unpack[HeatmapOptions]) -> Axes:
        """
        imshow(data, **opts)

        heatmap() over x in [0, cols], y in [0, rows].

        Keyword options (HeatmapOptions): cmap, vmin, vmax, colorbar, name, origin, contours, contour_color, contour_linewidth, contour_labels, contour_fontsize, hint_labels.
        """

    def cla(self) -> Axes:
        """Clear all plot objects (on Axes, also reset limits)."""

    def line_count(self) -> int: ...

    def scatter_count(self) -> int: ...

    def scatter_z_count(self) -> int: ...

    def bar_count(self) -> int: ...

    def heatmap_count(self) -> int: ...

    def line_data(self, i: int) -> LineData: ...

    def scatter_data(self, i: int) -> ScatterData: ...

    def scatter_z_data(self, i: int) -> ScatterZData: ...

    def bar_data(self, i: int) -> BarData:
        """bar() and hist() alike."""

    def heatmap_data(self, i: int) -> HeatmapData:
        """heatmap() and imshow() alike."""

    @overload
    def set_line_data(self, i: int, data: LineData) -> Axes: ...

    @overload
