    def x(self) -> float: ...

    @property
    def y(self) -> float: ...

    @property
    def axes(self) -> int:
        """
        The subplot under (x, y), as the index add_subplot() takes (a span: its first
        cell), or -1. inaxes is the object itself.
        """

    @property
    def inaxes(self) -> Axes | Axes3D | None:
        """The Axes or Axes3D under (x, y), or None."""

    @property
    def has_data(self) -> bool:
        """
        Whether xdata/ydata(/zdata) are set: over a 2D axes, or where a 3D cursor ray
        meets a Plane2D.
        """

    @property
    def xdata(self) -> float: ...

    @property
    def ydata(self) -> float: ...

    @property
    def zdata(self) -> float: ...

    @property
    def scroll_x(self) -> float: ...

    @property
    def scroll_y(self) -> float:
        """Wheel notches, positive away from the user; queued ones are summed."""

    @property
    def consumed(self) -> sextant._enums.EventConsumed:
        """
        What sextant itself did with the input (informational; nothing is suppressed).
        """

    @property
    def key(self) -> str:
        """key_down/key_up: 'a', 'A', 'ctrl+a', 'escape', 'f5', 'left', ..."""

    @property
    def width(self) -> int: ...

    @property
    def height(self) -> int: ...

    @property
    def pick_kind(self) -> sextant._enums.PickKind: ...

    @property
    def pick_object(self) -> int:
        """
        Index within its kind: the i of line_data(i), bar3d_data(i), ... (on the plane
        when pick_plane >= 0).
        """

    @property
    def pick_index(self) -> int: ...

    @property
    def pick_row(self) -> int: ...

    @property
    def pick_col(self) -> int: ...

    @property
    def pick_plane(self) -> int:
        """Axes3D.plane_at() index of the plane the picked object is on, or -1."""

    def __repr__(self) -> str: ...

def set_message_handler(handler: Callable[[str], None] | None) -> Callable[[str], None] | None:
    """
    Route sextant's diagnostics to handler(message: str); None restores the default,
    warnings.warn(message, RuntimeWarning). Returns the previous handler.
    """

def poll_events() -> None:
    """
    Pump window events once and deliver every figure's queued events on this thread.
    On macOS this is the pump and must run on the main thread (RuntimeError elsewhere).
    """

def run() -> None:
    """Block until every open figure has closed, delivering their events."""
